# Supabase project settings. Keep every key server-side (no VITE_ prefix).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Must exactly match the browser origin; use HTTPS on a hosted deployment.
APP_ORIGIN=http://127.0.0.1:8000
PORT=8000
# Optional automatic faithful transcription and reading generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Optional static Pages frontend build: public configuration only.
# VITE_PAGES=true
# VITE_BASE_PATH=/ships-log/
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_EDGE_API_URL=https://your-project.supabase.co/functions/v1/ships-log
