{
  "name": "seahawk-notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Captain Eddie's notebook: photographs in page order with their transcriptions",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/build.js && node server.js --edit",
    "dev": "node scripts/build.js && node server.js --edit",
    "test": "node scripts/build.js && node --test tests/*.test.js",
    "check:secrets": "node scripts/check-secrets.js",
    "context:refresh": "node scripts/prepare-context.js",
    "preview": "node scripts/build.js && node server.js"
  }
}
